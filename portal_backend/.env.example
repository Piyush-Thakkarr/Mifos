# Local Development Configuration
# This file is for local development only
# Railway/production will use environment variables set in Railway dashboard

# Local Fineract Docker instance (default for local dev)
MIFOS_BASE_URL=https://localhost:8443/fineract-provider/api/v1
MIFOS_TENANT_ID=default
MIFOS_ADMIN_USER=mifos
MIFOS_ADMIN_PASS=password
MIFOS_VERIFY_SSL=false
MIFOS_CLIENT_ID=1

# Django settings
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True

# For Railway/production, set these in Railway dashboard:
# MIFOS_BASE_URL=https://demo.mifos.io/fineract-provider/api/v1 (or your own Fineract)
# MIFOS_VERIFY_SSL=true (for production with valid SSL)
# MIFOS_CLIENT_ID=3 (or your client ID)
